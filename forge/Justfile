# Runs Rust Clippy policies, Cargo Vet cryptographic supply-chain audit, and Cargo Deny security check
[group('QA & Validation')]
audit:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo clippy --all-targets --all-features -- -D clippy::undocumented_unsafe_blocks -D clippy::multiple_unsafe_ops_per_block -D warnings || true
    cargo vet check || true
    cargo deny check || true

# Runs cargo-fuzz fuzzing harness across Rust components
[group('QA & Validation')]
fuzz component="all" time="60":
    #!/usr/bin/env bash
    set -euo pipefail
    for crate in specs/*/; do
        if [ -f "${crate}Cargo.toml" ] && [ -d "${crate}fuzz" ]; then
            comp=$(basename "$crate")
            if [ "{{ component }}" = "all" ] || [ "{{ component }}" = "$comp" ]; then
                echo "Fuzzing component $comp for {{ time }}s..."
                (cd "$crate" && cargo fuzz run fuzz_target_1 -- -max_total_time={{ time }} -sanitizer=address || true)
            fi
        fi
    done

# Runs AWS Kani formal verification proof harnesses on Rust spec targets
[group('QA & Validation')]
verify component="ermete-gatekeeper-rs":
    #!/usr/bin/env bash
    set -euo pipefail
    LD_LIBRARY_PATH=/usr/lib64:/lib64:${LD_LIBRARY_PATH:-} PATH=/home/ermete/.cargo/bin:$PATH cargo kani --package "{{ component }}"

