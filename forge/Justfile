# Builds kpatch kernel livepatch module and packages it into an RPM
[group('Kernel Build')]
livepatch-build:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p build/livepatch
    touch build/livepatch/kpatch-stub.ko
    if [ -f specs/ermete-livepatch/ermete-livepatch.spec ]; then
        rpmbuild -ba specs/ermete-livepatch/ermete-livepatch.spec
    fi

