[Unit]
Description=Ermete OS TPM2 Monotonic Counter Update on Successful Boot
After=boot-complete.target

[Service]
CPUWeight=50
MemoryHigh=64M
MemoryMax=128M
Type=oneshot
ExecStart=/usr/libexec/ermete/ermete-tpm-rollback-update.sh
RemainAfterExit=yes

# Extreme Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
NoNewPrivileges=yes
SystemCallFilter=@system-service
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
