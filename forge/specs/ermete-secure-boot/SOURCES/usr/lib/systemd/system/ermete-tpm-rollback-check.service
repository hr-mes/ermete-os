[Unit]
Description=Ermete OS TPM2 Monotonic Counter Rollback Check
DefaultDependencies=no
Before=systemd-pcrphase-sysinit.service sysinit.target
After=tpm2-abrmd.service local-fs.target
Wants=tpm2-abrmd.service

[Service]
CPUWeight=50
MemoryHigh=64M
MemoryMax=128M
Type=oneshot
ExecStart=/usr/libexec/ermete/ermete-tpm-rollback-check.sh
RemainAfterExit=yes

# Extreme Sandboxing
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
SystemCallFilter=@system-service
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=sysinit.target
