{
  "apiVersion": "cilium.io/v1alpha1",
  "kind": "TracingPolicy",
  "metadata": {
    "name": "sys-execve-monitor",
    "namespace": "kube-system"
  },
  "spec": {
    "kprobes": [
      {
        "call": "sys_execve",
        "syscall": true,
        "args": [
          {
            "index": 0,
            "type": "string"
          },
          {
            "index": 1,
            "type": "string_array"
          },
          {
            "index": 2,
            "type": "string_array"
          }
        ],
        "selectors": [
          {
            "matchArgs": []
          }
        ]
      }
    ]
  }
}