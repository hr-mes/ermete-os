[Unit]
Description=Ermete OS Hourly Btrfs Home Snapshot Trigger
Documentation=https://github.com/hr-mes/ermete-forge

[Service]
CPUWeight=50
MemoryMax=64M
Type=oneshot
ExecStart=/usr/bin/dbus-send --system --dest=org.ermete.Backup1 --type=method_call /org/ermete/Backup1 org.ermete.Backup1.CreateSnapshot string:"Istantanea oraria automatica"
