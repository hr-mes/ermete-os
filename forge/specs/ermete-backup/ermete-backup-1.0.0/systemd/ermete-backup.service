[Unit]
Description=Ermete OS Bcachefs Snapshot & Time Machine Daemon
Documentation=https://github.com/hr-mes/ermete-forge
PartOf=multi-user.target

[Service]
CPUWeight=20
IOWeight=20
MemoryHigh=384M
MemoryMax=512M
OOMScoreAdjust=300
Type=simple
ExecStart=/usr/bin/ermete-backup-daemon
Restart=always
RestartSec=3

# Extreme Sandboxing
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
SystemCallFilter=@system-service
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
