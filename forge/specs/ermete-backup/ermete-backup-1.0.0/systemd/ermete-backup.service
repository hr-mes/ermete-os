[Unit]
Description=Ermete OS Btrfs Snapshot & Time Machine Daemon
Documentation=https://github.com/hr-mes/ermete-forge
PartOf=multi-user.target

[Service]
CPUWeight=20
IOWeight=20
MemoryHigh=384M
MemoryMax=512M
OOMScoreAdjust=300
Type=simple
ExecStart=/usr/bin/ermete-backup-daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
