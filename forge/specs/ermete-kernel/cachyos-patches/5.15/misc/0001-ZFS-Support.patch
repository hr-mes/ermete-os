+	if (sha2_prov_handle != 0) {
+		if ((ret = crypto_unregister_provider(sha2_prov_handle)) !=
+		    CRYPTO_SUCCESS) {
+			cmn_err(CE_WARN,
+			    "sha2 _fini: crypto_unregister_provider() "
+			    "failed (0x%x)", ret);
+			return (EBUSY);
+		}
+		sha2_prov_handle = 0;
+	}
+
+	return (mod_remove(&modlinkage));
