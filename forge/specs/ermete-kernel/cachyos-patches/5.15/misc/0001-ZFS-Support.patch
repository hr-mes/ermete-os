+    znode_t *dzp, const char *name, uint64_t foid, boolean_t unlinked);
+#define	ZFS_NO_OBJECT	0	/* no object id */
+extern void zfs_log_link(zilog_t *zilog, dmu_tx_t *tx, uint64_t txtype,
+    znode_t *dzp, znode_t *zp, const char *name);
