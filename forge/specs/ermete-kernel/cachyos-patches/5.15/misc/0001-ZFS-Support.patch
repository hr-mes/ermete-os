+int
+sha1_mod_fini(void)
+{
+	int ret;
+
+	if (sha1_prov_handle != 0) {
+		if ((ret = crypto_unregister_provider(sha1_prov_handle)) !=
+		    CRYPTO_SUCCESS) {
+			cmn_err(CE_WARN,
+			    "sha1 _fini: crypto_unregister_provider() "
+			    "failed (0x%x)", ret);
+			return (EBUSY);
+		}
+		sha1_prov_handle = 0;
+	}
+
+	return (mod_remove(&modlinkage));
+}
