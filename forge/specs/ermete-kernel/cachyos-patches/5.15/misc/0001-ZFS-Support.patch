index 000000000000..5d6507c49db1
--- /dev/null
+++ b/fs/zfs/icp/algs/modes/ccm.c
@@ -0,0 +1,907 @@
+/*
+ * CDDL HEADER START
+ *
+ * The contents of this file are subject to the terms of the
