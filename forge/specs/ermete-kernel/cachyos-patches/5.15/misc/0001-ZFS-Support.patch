+	core \
+	spi \
+	io \
+	os \
+	algs \
+	algs/aes \
+	algs/edonr \
+	algs/modes \
+	algs/sha1 \
+	algs/sha2 \
+	algs/skein \
+	asm-x86_64 \
+	asm-x86_64/aes \
+	asm-x86_64/modes \
+	asm-x86_64/sha1 \
+	asm-x86_64/sha2 \
+	asm-i386 \
+	asm-generic
+
+all:
+	mkdir -p $(ICP_DIRS)
