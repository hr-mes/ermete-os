diff --git a/include/zfs/os/linux/spl/sys/rwlock.h b/include/zfs/os/linux/spl/sys/rwlock.h
new file mode 100644
index 000000000000..ba7620a1f344
--- /dev/null
+++ b/include/zfs/os/linux/spl/sys/rwlock.h
@@ -0,0 +1,200 @@
+/*
