+#define	EFI_RHT_ROOTAMD64	{ 0x4f68bce3, 0xe8cd, 0x4db1, 0x96, 0xe7, \
+				    { 0xfb, 0xca, 0xf9, 0x84, 0xb7, 0x09 } }
