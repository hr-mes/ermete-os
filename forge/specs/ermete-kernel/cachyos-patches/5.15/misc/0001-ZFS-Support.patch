+extern int dprintf_find_string(const char *string);
+extern void zfs_dbgmsg_print(const char *tag);
+#endif
+
+#ifdef	__cplusplus
+}
+#endif
+
+#endif	/* _SYS_ZFS_DEBUG_H */
