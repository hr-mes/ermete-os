+uint64_t
+spa_generate_guid(spa_t *spa)
+{
+	uint64_t guid;
+
+	if (spa != NULL) {
+		do {
+			(void) random_get_pseudo_bytes((void *)&guid,
+			    sizeof (guid));
+		} while (guid == 0 || spa_guid_exists(spa_guid(spa), guid));
+	} else {
+		do {
+			(void) random_get_pseudo_bytes((void *)&guid,
+			    sizeof (guid));
+		} while (guid == 0 || spa_guid_exists(guid, 0));
+	}
+
+	return (guid);
+}
