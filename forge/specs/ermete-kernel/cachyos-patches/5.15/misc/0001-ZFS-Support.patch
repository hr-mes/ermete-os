new file mode 100644
index 000000000000..7c56dd9c97f5
--- /dev/null
+++ b/fs/zfs/zfs/zfs_onexit.c
@@ -0,0 +1,176 @@
+/*
+ * CDDL HEADER START
+ *
+ * The contents of this file are subject to the terms of the
