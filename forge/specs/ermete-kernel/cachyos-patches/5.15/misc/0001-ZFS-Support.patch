diff --git a/include/zfs/os/linux/spl/sys/condvar.h b/include/zfs/os/linux/spl/sys/condvar.h
new file mode 100644
index 000000000000..ef405763ca56
--- /dev/null
+++ b/include/zfs/os/linux/spl/sys/condvar.h
@@ -0,0 +1,119 @@
+/*
