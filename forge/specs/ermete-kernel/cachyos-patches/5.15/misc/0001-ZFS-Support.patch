diff --git a/fs/zfs/icp/include/sys/crypto/ops_impl.h b/fs/zfs/icp/include/sys/crypto/ops_impl.h
new file mode 100644
index 000000000000..230d74b063fc
--- /dev/null
+++ b/fs/zfs/icp/include/sys/crypto/ops_impl.h
@@ -0,0 +1,630 @@
+/*
