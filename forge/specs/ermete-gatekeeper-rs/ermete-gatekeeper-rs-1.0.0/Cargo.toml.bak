[package]
name = "ermete-gatekeeper-rs"
version = "1.0.0"
edition = "2021"

[dependencies]
mimalloc = { version = "0.1", default-features = false }
tokio = { version = "1.0", features = ["full"] }
zbus = "4.4.0"
libc = "0.2"
xattr = "1.0"
gtk4 = "0.7.3"


[profile.release]
opt-level = 3
lto = true
codegen-units = 1
panic = "abort"
strip = true
