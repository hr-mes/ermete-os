[Unit]
Description=Ermete OS Glassmorphic Dock (Pure Rust Native UI)
Documentation=https://github.com/hr-mes/ermete-forge
BindsTo=graphical-session.target
After=graphical-session.target ermete-shell.service
PartOf=graphical-session.target

[Service]
CPUWeight=150
MemoryHigh=384M
MemoryMax=512M
OOMScoreAdjust=-300
Type=simple
Slice=session.slice
ExecStart=/usr/bin/ermete-shell-rs --dock
Restart=on-failure
RestartSec=2s

# Extreme Sandboxing
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
SystemCallFilter=@system-service
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=graphical-session.target
