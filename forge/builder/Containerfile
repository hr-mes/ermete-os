# TODO: Pin to SHA256 digest when available
FROM registry.fedoraproject.org/fedora:43
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install RPMFusion release packages to provision the GPG keys
RUN curl -fsSL -o /tmp/rpmfusion-free.rpm https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-43.noarch.rpm \
    && curl -fsSL -o /tmp/rpmfusion-nonfree.rpm https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-43.noarch.rpm \
    && dnf install -y /tmp/rpmfusion-free.rpm /tmp/rpmfusion-nonfree.rpm \
    && rm -f /tmp/rpmfusion-*.rpm

# Note: We rely entirely on the official RPMFusion repos installed above.

# Install core build tools and full development environment
RUN dnf install -y \
    dnf-plugins-core \
    rpm-build \
    rpmdevtools \
    gcc \
    gcc-c++ \
    make \
    createrepo_c \
    jq \
    skopeo \
    cargo \
    rust \
    cmake \
    mold \
    clang \
    sccache \
    buildah \
    git \
    tar \
    xz \
    curl \
    which \
    autoconf \
    automake \
    libtool \
    pkgconf-pkg-config \
    zlib-devel \
    openssl-devel \
    checkpolicy \
    policycoreutils \
    spdlog-devel \
    systemd-devel \
    nlohmann-json-devel \
    fmt-devel \
    cargo-rpm-macros \
    speech-dispatcher-devel \
    rpm-sign \
    gnupg2 \
    ipxe-bootimgs \
    && dnf clean all
