FROM registry.fedoraproject.org/fedora:43@sha256:ee2a496ffd34c4cab2fe8a2216686a11f604a58890050c59b31df992b05207f0
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install RPMFusion release packages to provision the GPG keys
RUN curl -fsSL -o /tmp/rpmfusion-free.rpm https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-43.noarch.rpm \
    && curl -fsSL -o /tmp/rpmfusion-nonfree.rpm https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-43.noarch.rpm \
    && dnf install -y /tmp/rpmfusion-free.rpm /tmp/rpmfusion-nonfree.rpm \
    && rm -f /tmp/rpmfusion-*.rpm

# Note: We rely entirely on the official RPMFusion repos installed above.

# Install core build tools and full development environment
RUN dnf install -y \
    dnf-plugins-core \
    rpm-build \
    rpmdevtools \
    gcc \
    gcc-c++ \
    make \
    createrepo_c \
    jq \
    skopeo \
    cargo \
    rust \
    cmake \
    mold \
    clang \
    sccache \
    buildah \
    git \
    tar \
    xz \
    curl \
    which \
    autoconf \
    automake \
    libtool \
    pkgconf-pkg-config \
    zlib-devel \
    openssl-devel \
    checkpolicy \
    policycoreutils \
    spdlog-devel \
    systemd-devel \
    nlohmann-json-devel \
    fmt-devel \
    cargo-rpm-macros \
    speech-dispatcher-devel \
    rpm-sign \
    gnupg2 \
    ipxe-bootimgs \
    flex \
    bison \
    ncurses-devel \
    elfutils-libelf-devel \
    elfutils-devel \
    bc \
    rsync \
    wget \
    cpio \
    perl \
    zstd \
    llvm \
    lld \
    ccache \
    hostname \
    dwarves \
    rustfmt \
    bindgen \
    iproute \
    fio \
    && dnf clean all


# Install Syft, Cosign, bpf-linker, and Kani Verifier (which requires rustup)
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin \
    && curl -O -L "https://github.com/sigstore/cosign/releases/latest/download/cosign-linux-amd64" \
    && mv cosign-linux-amd64 /usr/local/bin/cosign \
    && chmod +x /usr/local/bin/cosign \
    && cargo install bpf-linker \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && export PATH="$HOME/.cargo/bin:$PATH" \
    && cargo install --locked kani-verifier \
    && cargo kani setup

ENV PATH="/root/.cargo/bin:${PATH}"
