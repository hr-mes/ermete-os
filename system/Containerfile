
# --- IMMAGINE FINALE (PRODUZIONE AUTARCHICA ATOMICA) ---
# FIX: Renovate Bot sostituirà automaticamente il tag con il vero digest SHA256 crittografico
FROM ghcr.io/hr-mes/ermete-base-nvidia:latest
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG FEDORA_VERSION=43
ENV FEDORA_VERSION=$FEDORA_VERSION

# Aggiornamento globale disabilitato temporaneamente per prevenire conflitti seccomp con glibc in GitHub Actions.

# Epurazione Totale (Bedrock) del kernel Fedora upstream per impedire a dracut o dnf di intercettare versioni fantasma
RUN dnf5 -y remove --no-autoremove kernel kernel-core kernel-modules kernel-modules-core kernel-modules-extra kernel-tools && \
    rm -rf /usr/lib/modules/*

# SECURITY: ermete-install.ks contains placeholder SSH keys that MUST be replaced before production

# Estrazione pacchetti RPM dai Micro-Container OCI di Ermete Forge (Isolamento Totale per Tier)
# I pacchetti vengono copiati chirurgicamente nei singoli Tier prima dell'installazione per evitare il cache-busting OCI.


# Execute all modular scripts sequentially in a single transaction to prevent OCI layer bloat
# and preserve atomicity of the RPM database.
# FIX BEDROCK (Universal Package Resolution & Zero-Conflict Ordering):
# 1) We install ONLY ermete-base-config first via rpm -Uvh so that repository definitions
#    (/etc/yum.repos.d/rpmfusion.repo, gpg keys, etc.) are injected into the rootfs.
# 2) We run dnf5 install to download and resolve all upstream packages and external dependencies.

# TIER 0: BEDROCK HARDWARE & KERNEL FOUNDATION (~3.3 GB - Static Cache - Reboot Required)
RUN --mount=type=bind,from=ghcr.io/hr-mes/ermete-os-forge-tier0-repo:latest,source=/,target=/mnt/tier0-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    if ls /mnt/tier0-repo/ermete-base-config*.rpm 1> /dev/null 2>&1; then \
        echo "Tier 0: Installing core Ermete Forge base configuration..." && \
        rpm -Uvh --replacefiles --replacepkgs --nodeps /mnt/tier0-repo/ermete-base-config*.rpm; \
    fi && \
    RPM_LIST=$(find /mnt/tier0-repo -name "*.rpm" 2>/dev/null | grep -vE 'systemd-standalone-|.*-free-.*\.rpm|glibc32|kernel-debug|rpm-.*\.rpm' || true) && \
    if [ -n "$RPM_LIST" ]; then \
        echo "Tier 0: Installing Bedrock hardware, kernel Chimera & NVIDIA dependencies..." && \
        TO_INSTALL="" && TO_UPGRADE="" && \
        for rpm in $RPM_LIST; do \
            pkg_name=$(rpm -qp --queryformat "%{NAME}\n" "$rpm" 2>/dev/null || true) && \
            if rpm -q "$pkg_name" >/dev/null 2>&1; then \
                TO_UPGRADE="$TO_UPGRADE $rpm"; \
            else \
                TO_INSTALL="$TO_INSTALL $rpm"; \
            fi; \
        done && \
        if [ -n "$TO_UPGRADE" ]; then dnf5 upgrade -y $TO_UPGRADE || true; fi && \
        if [ -n "$TO_INSTALL" ]; then dnf5 install -y --allowerasing --setopt=install_weak_deps=False --setopt=tsflags=nodocs $TO_INSTALL; fi; \
    fi && \
    rm -rf /usr/lib/firmware/{mellanox,qlogic,netronome,liquidio,cxgb4,bnx2x,cavium,dpaa2}

# Dracut initramfs generation moved to AFTER Tier 1-3 installations to ensure all sysusers and configurations are captured.

# TIER 1: DISPLAY SERVER & CORE USERSPACE SERVICES (~34 MB)
RUN --mount=type=bind,from=ghcr.io/hr-mes/ermete-os-forge-tier1-repo:latest,source=/,target=/mnt/tier1-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    if find /mnt/tier1-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 1: Installing Display Server & Core Userspace Services..." && \
        RPM_LIST=$(find /mnt/tier1-repo -name "*.rpm" 2>/dev/null | grep -vE -- '-devel-|-doc-|debuginfo|debugsource' || true) && \
        if [ -n "$RPM_LIST" ]; then \
            TO_INSTALL="" && TO_UPGRADE="" && \
            for rpm in $RPM_LIST; do \
                pkg_name=$(rpm -qp --queryformat "%{NAME}\n" "$rpm" 2>/dev/null || true) && \
                if rpm -q "$pkg_name" >/dev/null 2>&1; then TO_UPGRADE="$TO_UPGRADE $rpm"; else TO_INSTALL="$TO_INSTALL $rpm"; fi; \
            done && \
            if [ -n "$TO_UPGRADE" ]; then dnf5 upgrade -y $TO_UPGRADE || true; fi && \
            if [ -n "$TO_INSTALL" ]; then dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $TO_INSTALL; fi; \
        fi; \
    fi

# TIER 2: DESIGN SYSTEM & STATIC ASSETS (~18 MB)
RUN --mount=type=bind,from=ghcr.io/hr-mes/ermete-os-forge-tier2-repo:latest,source=/,target=/mnt/tier2-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    if find /mnt/tier2-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 2: Installing Design System & Static Assets..." && \
        RPM_LIST=$(find /mnt/tier2-repo -name "*.rpm" 2>/dev/null | grep -vE -- '-devel-|-doc-|debuginfo|debugsource' || true) && \
        if [ -n "$RPM_LIST" ]; then \
            TO_INSTALL="" && TO_UPGRADE="" && \
            for rpm in $RPM_LIST; do \
                pkg_name=$(rpm -qp --queryformat "%{NAME}\n" "$rpm" 2>/dev/null || true) && \
                if rpm -q "$pkg_name" >/dev/null 2>&1; then TO_UPGRADE="$TO_UPGRADE $rpm"; else TO_INSTALL="$TO_INSTALL $rpm"; fi; \
            done && \
            if [ -n "$TO_UPGRADE" ]; then dnf5 upgrade -y $TO_UPGRADE || true; fi && \
            if [ -n "$TO_INSTALL" ]; then dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $TO_INSTALL; fi; \
        fi; \
    fi

# TIER 3: AGILE RUST SHELL & APPS (~8 MB - Instant Live Swap Layer)
RUN --mount=type=bind,from=ghcr.io/hr-mes/ermete-os-forge-tier3-repo:latest,source=/,target=/mnt/tier3-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    if find /mnt/tier3-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 3: Installing Agile Rust Shell & Apps..." && \
        RPM_LIST=$(find /mnt/tier3-repo -name "*.rpm" 2>/dev/null | grep -vE -- '-devel-|-doc-|debuginfo|debugsource' || true) && \
        if [ -n "$RPM_LIST" ]; then \
            TO_INSTALL="" && TO_UPGRADE="" && \
            for rpm in $RPM_LIST; do \
                pkg_name=$(rpm -qp --queryformat "%{NAME}\n" "$rpm" 2>/dev/null || true) && \
                if rpm -q "$pkg_name" >/dev/null 2>&1; then TO_UPGRADE="$TO_UPGRADE $rpm"; else TO_INSTALL="$TO_INSTALL $rpm"; fi; \
            done && \
            if [ -n "$TO_UPGRADE" ]; then dnf5 upgrade -y $TO_UPGRADE || true; fi && \
            if [ -n "$TO_INSTALL" ]; then dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $TO_INSTALL; fi; \
        fi; \
    fi

### BEDROCK SELINUX (Declarative Compilation)
# We DO NOT use allow_execmem 1 to preserve enterprise security (W^X).
# SELinux policies are managed declaratively via /etc/selinux/targeted.

### DICHIARATIVITÀ ASSOLUTA (SYSTEMD PRESETS & SYSUSERS)
RUN systemctl enable systemd-sysext.service && systemd-sysusers && systemctl preset-all && systemctl --global preset-all

### BEDROCK KERNEL & INITRAMFS GENERATION (Moved here to capture sysusers and Tiers 1-3)
# L'initramfs dinamico viene rigenerato per sincronizzare i moduli kernel e NVIDIA
# ed evitare API mismatch con l'ecosistema userspace.
RUN QUALIFIED_KERNEL="" && \
    for k in /lib/modules/*; do \
        if [ -e "$k/vmlinuz" ] || [ -L "$k/vmlinuz" ]; then \
            QUALIFIED_KERNEL=$(basename "$k") && break; \
        fi; \
    done && \
    if [ -z "$QUALIFIED_KERNEL" ]; then echo "ERRORE: Nessun vmlinuz trovato in /lib/modules! Build abortita." && exit 1; fi && \
    echo "Found Chimera Kernel: ${QUALIFIED_KERNEL}" && \
    if [ -L "/usr/lib/modules/${QUALIFIED_KERNEL}/vmlinuz" ]; then \
        REAL_VMLINUZ=$(readlink -f "/usr/lib/modules/${QUALIFIED_KERNEL}/vmlinuz") && \
        rm -f "/usr/lib/modules/${QUALIFIED_KERNEL}/vmlinuz" && \
        cp "$REAL_VMLINUZ" "/usr/lib/modules/${QUALIFIED_KERNEL}/vmlinuz"; \
    fi && \
    depmod "${QUALIFIED_KERNEL}" && \
    echo "Generazione Dinamica Initramfs per ${QUALIFIED_KERNEL}..." && \
    dracut --no-hostonly --kver "${QUALIFIED_KERNEL}" --reproducible --compress "zstd -T0 -15" -v \
        --strip --omit-drivers "nouveau" \
        --add ostree --add fido2 \
        --install "/etc/group" --install "/etc/passwd" \
        -f /usr/lib/modules/${QUALIFIED_KERNEL}/initramfs.img && \
    chmod 0644 /usr/lib/modules/${QUALIFIED_KERNEL}/initramfs.img && \
    ldconfig





### HARDENING & OSTREE LINTING FIXES
RUN shopt -s nullglob && \
    dnf5 remove -y --no-autoremove \
        gcc make llvm-static rust-std-static mesa-dxil-devel \
        edk2-aarch64 qemu-user qemu-user-static distribution-gpg-keys-copr \
        nodejs-docs glibc-all-langpacks python3-botocore kernel-debug kernel-debug-core kernel-debug-modules kernel-debug-modules-core kernel-debug-modules-extra && \
    for d in /usr/lib/modules/*; do if [ -d "$d" ] && [ ! -e "$d/vmlinuz" ] && [ ! -L "$d/vmlinuz" ]; then rm -rf "$d"; fi; done && \
    rm -f /etc/machine-id && touch /etc/machine-id && \
    dnf5 clean all && \
    find /tmp /run /etc/NetworkManager/system-connections -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /var/lib/dnf5/* /var/tmp/* /var/log/*

### LINTING
## Verify final image and contents are correct.
RUN ls -la /usr/lib/modules/ && bootc container lint

# Strip SUID/SGID from unnecessary binaries
RUN find /usr/bin /usr/sbin /usr/libexec -type f \( -perm -4000 -o -perm -2000 \) | grep -vE 'sudo|su|passwd|polkit-agent-helper-1|dbus-daemon-launch-helper|ssh-keysign' | xargs -r chmod u-s,g-s || true
