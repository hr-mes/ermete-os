FROM ghcr.io/hr-mes/ermete-base-nvidia:latest
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG FEDORA_VERSION=43
ENV FEDORA_VERSION=$FEDORA_VERSION
ARG TETRAGON_VERSION=v1.3.0

# Purge upstream Fedora kernel packages
RUN dnf5 -y remove --no-autoremove kernel kernel-core kernel-modules kernel-modules-core kernel-modules-extra kernel-tools kernel-devel kernel-headers && \
    rm -rf /usr/lib/modules/*

# TIER 0: BEDROCK HARDWARE & KERNEL FOUNDATION
RUN --mount=type=bind,from=ghcr.io/hr-mes/ermete-os-forge-tier0-repo:latest,source=/,target=/mnt/tier0-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    BASE_CONFIG=$(find /mnt/tier0-repo -name "ermete-base-config*.rpm" | head -n 1) && \
    if [ -n "$BASE_CONFIG" ]; then \
        echo "Tier 0: Installing core Ermete Forge base configuration..." && \
        rpm -e --nodeps fedora-logos || true && \
        rpm -Uvh --replacefiles --replacepkgs --nodeps "$BASE_CONFIG"; \
    fi && \
    RAW_RPM_LIST=$(find /mnt/tier0-repo -name "*.rpm" 2>/dev/null | awk '!/systemd-standalone-|.*-free-.*\.rpm|glibc32|kernel-debug|rpm-.*\.rpm|fedora-release-|selinux-policy|ermete-base-config|-doc-|debuginfo|debugsource/ && (!/-devel-/ || /kernel-devel/)' || true) && \
    RPM_LIST="" && \
    for rpm in $RAW_RPM_LIST; do \
        if [[ "$rpm" == *kmod-nvidia-* ]] && [[ "$rpm" != *chimera* ]]; then \
            continue; \
        fi; \
        RPM_LIST="$RPM_LIST $rpm"; \
    done && \
    if [ -n "$RPM_LIST" ]; then \
        echo "Tier 0: Installing Bedrock hardware, kernel Chimera & NVIDIA dependencies..." && \
        dnf5 install -y --allowerasing --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
    fi && \
    echo "excludepkgs=kernel kernel-core kernel-modules kernel-modules-core kernel-modules-extra kernel-devel kernel-debug kernel-debug-devel kernel-debug-core kernel-debug-modules kernel-debug-modules-core kernel-debug-modules-extra" >> /etc/dnf/dnf.conf && \
    rm -rf /usr/lib/firmware/{mellanox,qlogic,netronome,liquidio,cxgb4,bnx2x,cavium,dpaa2}

# Tier 0: Install Cilium Tetragon eBPF Runtime Security
RUN echo "Tier 0: Installing Cilium Tetragon eBPF Runtime Security (${TETRAGON_VERSION})..." && \
    ARCH=$(uname -m) && \
    case "${ARCH}" in \
        x86_64)  TETRAGON_ARCH="amd64" ;; \
        aarch64) TETRAGON_ARCH="arm64" ;; \
        *)       TETRAGON_ARCH="${ARCH}" ;; \
    esac && \
    curl -sSL "https://github.com/cilium/tetragon/releases/download/${TETRAGON_VERSION}/tetragon-${TETRAGON_VERSION}-${TETRAGON_ARCH}.tar.gz" -o /tmp/tetragon.tar.gz && \
    mkdir -p /tmp/tetragon && \
    tar -xzf /tmp/tetragon.tar.gz -C /tmp/tetragon && \
    cp /tmp/tetragon/tetragon /usr/bin/tetragon && \
    cp /tmp/tetragon/tetra /usr/bin/tetra && \
    chmod 0755 /usr/bin/tetragon /usr/bin/tetra && \
    mkdir -p /var/lib/tetragon /var/log/tetragon /etc/tetragon/tetragon.tp.d && \
    if [ -d /tmp/tetragon/bpf ]; then cp -r /tmp/tetragon/bpf /var/lib/tetragon/; fi && \
    rm -rf /tmp/tetragon*

COPY tetragon.service /usr/lib/systemd/system/tetragon.service
COPY tetragon.yaml /etc/tetragon/tetragon.yaml
COPY tetragon.tp.d/sys_execve.yaml /etc/tetragon/tetragon.tp.d/sys_execve.yaml

# TIER 1: CORE USERSERVICE, DBUS & POLICYKIT
RUN --mount=type=bind,from=ghcr.io/hr-mes/ermete-os-forge-tier1-repo:latest,source=/,target=/mnt/tier1-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    echo "Tier 1: Installing Scudo Hardened Allocator (compiler-rt)..." && \
    dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs compiler-rt && \
    if find /mnt/tier1-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 1: Installing Core User Services, DBus & Policies..." && \
        RPM_LIST=$(find /mnt/tier1-repo -name "*.rpm" 2>/dev/null | grep -vE -- '-devel-|-doc-|debuginfo|debugsource' || true) && \
        if [ -n "$RPM_LIST" ]; then \
            dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
        fi; \
    fi && \
    SCUDO_LIB=$(find /usr/lib/clang/ -name "libclang_rt.scudo_standalone.so" 2>/dev/null | head -n 1) && \
    if [ -n "$SCUDO_LIB" ]; then \
        ln -sf "$SCUDO_LIB" /usr/lib64/libscudo.so && \
        echo "/usr/lib64/libscudo.so" > /etc/ld.so.preload && \
        echo 'SCUDO_OPTIONS="allocator_may_return_null=true:zero_contents=false:dealloc_type_mismatch=false:quarantine_size_kb=0"' >> /etc/environment && \
        mkdir -p /etc/systemd/system/greetd.service.d /etc/systemd/system/ermete-llm.service.d && \
        echo -e "[Service]\nEnvironment=\"LD_PRELOAD=\"" > /etc/systemd/system/greetd.service.d/override.conf && \
        echo -e "[Service]\nEnvironment=\"LD_PRELOAD=\"" > /etc/systemd/system/ermete-llm.service.d/override.conf && \
        echo "Tier 1: Scudo Allocator enabled globally via /etc/ld.so.preload ($SCUDO_LIB)"; \
    else \
        echo "ERROR: libclang_rt.scudo_standalone.so not found!" && exit 1; \
    fi

# TIER 2: DESIGN SYSTEM & STATIC ASSETS
RUN --mount=type=bind,from=ghcr.io/hr-mes/ermete-os-forge-tier2-repo:latest,source=/,target=/mnt/tier2-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    if find /mnt/tier2-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 2: Installing Design System & Static Assets..." && \
        RPM_LIST=$(find /mnt/tier2-repo -name "*.rpm" 2>/dev/null | grep -vE -- '-devel-|-doc-|debuginfo|debugsource' || true) && \
        if [ -n "$RPM_LIST" ]; then \
            dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
        fi; \
    fi

# TIER 3: AGILE RUST SHELL & APPS
RUN --mount=type=bind,from=ghcr.io/hr-mes/ermete-os-forge-tier3-repo:latest,source=/,target=/mnt/tier3-repo \
    --mount=type=cache,dst=/var/cache --mount=type=cache,dst=/var/cache/libdnf5 \
    if find /mnt/tier3-repo -name "*.rpm" 1> /dev/null 2>&1; then \
        echo "Tier 3: Installing Agile Rust Shell & Apps..." && \
        RPM_LIST=$(find /mnt/tier3-repo -name "*.rpm" 2>/dev/null | grep -vE -- '-devel-|-doc-|debuginfo|debugsource' || true) && \
        if [ -n "$RPM_LIST" ]; then \
            dnf5 install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs $RPM_LIST; \
        fi; \
    fi

# Declarative Systemd presets & sysusers
RUN systemctl enable tetragon.service systemd-sysext.service && systemd-sysusers && systemctl preset-all && systemctl --global preset-all

# Initramfs generation
RUN QUALIFIED_KERNEL="" && \
    for k in /lib/modules/*; do \
        if [ -e "$k/vmlinuz" ] || [ -L "$k/vmlinuz" ]; then \
            QUALIFIED_KERNEL=$(basename "$k") && break; \
        fi; \
    done && \
    if [ -z "$QUALIFIED_KERNEL" ]; then echo "ERROR: No vmlinuz found in /lib/modules!" && exit 1; fi && \
    echo "Found Chimera Kernel: ${QUALIFIED_KERNEL}" && \
    if [ -L "/usr/lib/modules/${QUALIFIED_KERNEL}/vmlinuz" ]; then \
        REAL_VMLINUZ=$(readlink -f "/usr/lib/modules/${QUALIFIED_KERNEL}/vmlinuz") && \
        rm -f "/usr/lib/modules/${QUALIFIED_KERNEL}/vmlinuz" && \
        cp "$REAL_VMLINUZ" "/usr/lib/modules/${QUALIFIED_KERNEL}/vmlinuz"; \
    fi && \
    depmod "${QUALIFIED_KERNEL}" && \
    dracut --no-hostonly --kver "${QUALIFIED_KERNEL}" --reproducible --compress "zstd -T0 -15" -v \
        --strip --omit-drivers "nouveau" \
        --add ostree --add fido2 \
        --install "/etc/group" --install "/etc/passwd" \
        -f /usr/lib/modules/${QUALIFIED_KERNEL}/initramfs.img && \
    chmod 0644 /usr/lib/modules/${QUALIFIED_KERNEL}/initramfs.img && \
    ldconfig

# Hardening & OSTree cleanup
RUN dnf5 remove -y --no-autoremove \
        gcc make llvm-static rust-std-static mesa-dxil-devel \
        edk2-aarch64 qemu-user qemu-user-static distribution-gpg-keys-copr \
        nodejs-docs glibc-all-langpacks python3-botocore kernel-debug kernel-debug-core kernel-debug-modules kernel-debug-modules-core kernel-debug-modules-extra && \
    for d in /usr/lib/modules/*; do if [ -d "$d" ] && [ ! -e "$d/vmlinuz" ] && [ ! -L "$d/vmlinuz" ]; then rm -rf "$d"; fi; done && \
    rm -f /etc/machine-id && touch /etc/machine-id && \
    dnf5 clean all && \
    find /tmp /run /etc/NetworkManager/system-connections -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /var/lib/dnf5/* /var/tmp/* /var/log/*

# Image Validation & Linting
COPY test-nvidia-modules.sh /usr/bin/test-nvidia-modules.sh
RUN ls -la /usr/lib/modules/ && bootc container lint && /usr/bin/test-nvidia-modules.sh
