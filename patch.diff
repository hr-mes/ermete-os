--- forge/scripts/fetch_repo_rpms.sh
+++ forge/scripts/fetch_repo_rpms.sh
@@ -158,6 +158,16 @@
 echo "=== Post-Processing: Deduplicating RPMs (Keeping Latest) ==="
 # In case of leftover duplicates from parallel jobs, keep only the latest version of each RPM
 for tier in tier0 tier1 tier2 tier3; do
+  # FORCED PURGE OF ORPHAN KERNEL PACKAGES (Due to 'kernel' -> 'ermete-kernel' rename)
+  rm -f repo-cache/repo-${tier}/kernel-[0-9]*.rpm \
+        repo-cache/repo-${tier}/kernel-core-[0-9]*.rpm \
+        repo-cache/repo-${tier}/kernel-modules-[0-9]*.rpm \
+        repo-cache/repo-${tier}/kernel-modules-core-[0-9]*.rpm \
+        repo-cache/repo-${tier}/kernel-modules-extra-[0-9]*.rpm \
+        repo-cache/repo-${tier}/kernel-modules-internal-[0-9]*.rpm \
+        repo-cache/repo-${tier}/kernel-uki-virt-[0-9]*.rpm \
+        repo-cache/repo-${tier}/kernel-uki-virt-addons-[0-9]*.rpm \
+        repo-cache/repo-${tier}/kernel-devel-[0-9]*.rpm \
+        repo-cache/repo-${tier}/kernel-devel-matched-[0-9]*.rpm \
+        2>/dev/null || true
+
   for rpm_file in repo-cache/repo-${tier}/*.rpm; do
     [ -e "$rpm_file" ] || continue
     pkg_name=$(rpm -qp --queryformat '%{NAME}' "$rpm_file" 2>/dev/null || true)
